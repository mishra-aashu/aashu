{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aashu AI",
  "version": "1.4.0",
  "identifier": "com.aashu.ai",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cargo run",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Aashu AI",
        "width": 1280,
        "height": 820,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
