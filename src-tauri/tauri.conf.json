{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aashu AI",
  "version": "1.4.0",
  "identifier": "com.aashu.ai",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Aashu AI",
        "width": 1280,
        "height": 820,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --enable-features=WebRtcHideLocalIpsWithMdns"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Aashu",
    "copyright": "Copyright © 2026 Aashu. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Aashu AI - Hands-Free Voice Assistant with Vector Memory",
    "longDescription": "Aashu AI is a personal voice assistant with persistent vector memory, custom wake-words, and multi-language support.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "languages": ["English", "Hindi"]
      }
    }
  }
}
